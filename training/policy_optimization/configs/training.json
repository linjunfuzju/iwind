{
  "policy_model_path": "../instruction_tuning/outputs/sft_merged",
  "reward_model_path": "../reward_modeling/outputs/reward_model",
  "train_file": "./data/grpo_train.jsonl",
  "validation_file": "./data/grpo_validation.jsonl",
  "output_dir": "./outputs/grpo",
  "system_prompt": "You are a senior offshore wind and marine engineering specialist. Provide technically rigorous analysis, state assumptions, distinguish evidence from uncertainty, and avoid unsupported operational claims.",
  "reward_max_length": 2048,
  "reward_transport": "local",
  "reward_device": "rank",
  "reward_adapter": "scalar_logits",
  "per_device_train_batch_size": 4,
  "per_device_eval_batch_size": 4,
  "gradient_accumulation_steps": 4,
  "learning_rate": 1e-6,
  "num_train_epochs": 3.0,
  "logging_steps": 1,
  "eval_steps": 10,
  "save_steps": 10,
  "save_total_limit": 2,
  "num_generations": 4,
  "temperature": 0.7,
  "top_p": 0.9,
  "epsilon": 0.2,
  "beta": 0.0,
  "max_prompt_length": 512,
  "max_completion_length": 1024,
  "warmup_steps": 10,
  "max_grad_norm": 1.0,
  "seed": 42,
  "bf16": true
}
